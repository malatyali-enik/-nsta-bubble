<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VIP DM Bubble"
        android:textColor="#F8FAFC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instagram VIP Bildirim ve Yüzen Baloncuk Yöneticisi"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="8dp" />

    <!-- Durum Kartı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="20dp"
        android:layout_marginTop="36dp">

        <TextView
            android:id="@+id/tvNotifStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bildirim Erişimi: Bekleniyor..."
            android:textColor="#E2E8F0"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGrantNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bildirim Erişim İznini Aç"
            android:backgroundTint="#E1306C"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvOverlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Üstte Çizim İzni: Bekleniyor..."
            android:textColor="#E2E8F0"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Üstte Görünme İznini Aç"
            android:backgroundTint="#833AB4"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="İzinler verildikten sonra VIP listenizdeki birinden Instagram mesajı geldiğinde ekranda baloncuk belirecektir."
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textAlignment="center"
        android:layout_marginTop="24dp" />

</LinearLayout>